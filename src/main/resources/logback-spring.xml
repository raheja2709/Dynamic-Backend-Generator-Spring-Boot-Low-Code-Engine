<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender (all profiles) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId:-}] %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Console appender with JSON format (prod/docker) -->
    <springProfile name="prod | docker">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
            </encoder>
        </appender>
    </springProfile>

    <!-- Rolling file appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId:-}] %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Database appender for ERROR/WARN -->
    <appender name="DB" class="com.user.driven.operations.app.common.logging.DatabaseLogAppender" />

    <!-- Dev profile: console + file + DB -->
    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="DB" />
        </root>
    </springProfile>

    <!-- Prod/Docker profile: JSON console + file + DB -->
    <springProfile name="prod | docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON" />
            <appender-ref ref="FILE" />
            <appender-ref ref="DB" />
        </root>
    </springProfile>

    <!-- Default (no profile): console + file + DB -->
    <springProfile name="default">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
            <appender-ref ref="FILE" />
            <appender-ref ref="DB" />
        </root>
    </springProfile>

</configuration>
