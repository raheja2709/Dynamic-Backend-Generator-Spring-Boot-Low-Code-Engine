# ==============================================
# Dynamic Backend Generator - Environment Variables
# ==============================================
# Copy this file to .env and adjust values for your environment.
# Variables marked (required) have no safe default in prod/docker profiles.

# ----------------------------------------------
# Database Configuration
# (required for prod and docker profiles)
# ----------------------------------------------

# JDBC connection URL for the PostgreSQL database
# Docker profile default uses service name "db" as hostname
DB_URL=jdbc:postgresql://localhost:5432/user_driven_operation_mng_sys

# Database username
DB_USERNAME=postgres

# Database password (required - change from default in production)
DB_PASSWORD=your_password_here

# ----------------------------------------------
# Application Configuration (optional)
# ----------------------------------------------

# Directory where generated projects are written
APP_GENERATED_PROJECTS_DIR=./generated-projects

# Path to the Maven executable used by the Build Verifier
APP_MAVEN_PATH=mvn

# ----------------------------------------------
# Spring Configuration (optional)
# ----------------------------------------------

# Active Spring profile: dev, prod, or docker (default: dev)
SPRING_PROFILES_ACTIVE=dev
